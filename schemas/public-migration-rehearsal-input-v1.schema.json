{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TamaT-LLC/depgraph-cli/schemas/public-migration-rehearsal-input-v1.schema.json",
  "title": "depgraph public migration rehearsal input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "production_repository",
    "temporary_repository",
    "target_attestation",
    "production_plan_features_digest",
    "temporary_plan_features_digest",
    "production_visibility_unchanged",
    "steps",
    "anonymous_smoke"
  ],
  "properties": {
    "schema_version": {
      "const": "public-migration-rehearsal-input-v1"
    },
    "production_repository": {
      "$ref": "#/$defs/repository"
    },
    "temporary_repository": {
      "$ref": "#/$defs/repository"
    },
    "target_attestation": {
      "$ref": "#/$defs/target_attestation"
    },
    "production_plan_features_digest": {
      "$ref": "#/$defs/digest"
    },
    "temporary_plan_features_digest": {
      "$ref": "#/$defs/digest"
    },
    "production_visibility_unchanged": {
      "type": "boolean"
    },
    "steps": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "anonymous_smoke": {
      "$ref": "#/$defs/anonymous_smoke"
    }
  },
  "$defs": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}/[A-Za-z0-9_.-]{1,128}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "team_identity": {
      "type": "string",
      "pattern": "^team:[A-Za-z0-9_.-]{1,128}$"
    },
    "target_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_repository_digest",
        "temporary_repository_digest",
        "production_plan_features_digest",
        "temporary_plan_features_digest",
        "producer_identity",
        "approver_identity",
        "attestation_digest"
      ],
      "properties": {
        "production_repository_digest": {
          "$ref": "#/$defs/digest"
        },
        "temporary_repository_digest": {
          "$ref": "#/$defs/digest"
        },
        "production_plan_features_digest": {
          "$ref": "#/$defs/digest"
        },
        "temporary_plan_features_digest": {
          "$ref": "#/$defs/digest"
        },
        "producer_identity": {
          "$ref": "#/$defs/team_identity"
        },
        "approver_identity": {
          "$ref": "#/$defs/team_identity"
        },
        "attestation_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "phase": {
      "enum": [
        "verify_temporary_target",
        "capture_backup_and_settings",
        "freeze_writes",
        "change_visibility",
        "restore_rulesets",
        "enable_security",
        "verify_desired_settings",
        "run_anonymous_smoke",
        "reopen_writes",
        "cleanup_temporary_repository"
      ]
    },
    "evidence_kind": {
      "enum": [
        "target_attestation",
        "backup_and_settings_snapshot",
        "write_freeze_audit",
        "visibility_observation",
        "ruleset_snapshot",
        "security_snapshot",
        "desired_settings_evaluation",
        "anonymous_smoke_report",
        "write_reopen_audit",
        "cleanup_attestation"
      ]
    },
    "tool_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "acquisition_digest",
        "configuration_digest"
      ],
      "properties": {
        "name": {
          "const": "depgraph-public-migration-checkpoint-verifier"
        },
        "version": {
          "const": "1.0.0"
        },
        "acquisition_digest": {
          "$ref": "#/$defs/digest"
        },
        "configuration_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "checkpoint_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject_repository_digest",
        "artifact_digests",
        "verifier"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/evidence_kind"
        },
        "subject_repository_digest": {
          "$ref": "#/$defs/digest"
        },
        "artifact_digests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "verifier": {
          "$ref": "#/$defs/tool_identity"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "outcome",
        "evidence",
        "evidence_digest"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "outcome": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/checkpoint_evidence"
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "anonymous_smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clone",
        "source_archive",
        "readme_and_docs",
        "community_links",
        "issue_templates",
        "actions",
        "release",
        "package_download",
        "evidence_digest"
      ],
      "properties": {
        "clone": {
          "type": "boolean"
        },
        "source_archive": {
          "type": "boolean"
        },
        "readme_and_docs": {
          "type": "boolean"
        },
        "community_links": {
          "type": "boolean"
        },
        "issue_templates": {
          "type": "boolean"
        },
        "actions": {
          "type": "boolean"
        },
        "release": {
          "type": "boolean"
        },
        "package_download": {
          "type": "boolean"
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
