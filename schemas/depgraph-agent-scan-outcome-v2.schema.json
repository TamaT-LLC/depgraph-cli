{"$defs":{"AgentAnalysisCoverage":{"additionalProperties":false,"description":"Conservative repository-level projection of the durable analysis-unit\nledger. Execution completion and semantic precision are separate facts:\n`complete` describes terminal execution of every unit, while\n`semantic_complete_units` counts the subset with a verified semantic\nresult. The counts are checked before publication so an incomplete\nexecution cannot be represented as complete by an Agent client.","properties":{"cancelled_units":{"format":"uint64","minimum":0,"type":"integer"},"complete":{"type":"boolean"},"completed_units":{"format":"uint64","minimum":0,"type":"integer"},"contract_version":{"$ref":"#/$defs/AgentLabel"},"expected_units":{"format":"uint64","minimum":0,"type":"integer"},"failed_units":{"format":"uint64","minimum":0,"type":"integer"},"input_digest":{"anyOf":[{"$ref":"#/$defs/AnalysisInputDigest"},{"type":"null"}]},"plan_id":{"anyOf":[{"$ref":"#/$defs/AgentId"},{"type":"null"}]},"reasons":{"items":{"$ref":"#/$defs/AgentLabel"},"maxItems":1024,"type":"array"},"semantic_complete_units":{"format":"uint64","minimum":0,"type":"integer"},"unanalysed_units":{"format":"uint64","minimum":0,"type":"integer"}},"required":["contract_version","expected_units","completed_units","failed_units","unanalysed_units","cancelled_units","semantic_complete_units","complete","reasons"],"type":"object"},"AgentAnalysisProgress":{"additionalProperties":false,"description":"Snapshot of all unit progress observed by a scan or daemon attempt.","properties":{"stop_reason":{"anyOf":[{"$ref":"#/$defs/AgentLabel"},{"type":"null"}]},"units":{"items":{"$ref":"#/$defs/AgentAnalysisUnitProgress"},"maxItems":100000,"type":"array"}},"required":["units"],"type":"object"},"AgentAnalysisStage":{"description":"Stage names exposed by the resumable analysis execution contract.","enum":["repository","syntax","typed","semantic"],"type":"string"},"AgentAnalysisUnitProgress":{"additionalProperties":false,"description":"Bounded progress for one worker unit.  Unit IDs are stable logical IDs;\nsource-batch chunk IDs are kept in the Store ledger and are deliberately\nnot duplicated in this progress projection.","properties":{"adapter":{"$ref":"#/$defs/AgentLabel"},"duration_ms":{"format":"uint64","minimum":0,"type":"integer"},"failure_reason":{"anyOf":[{"$ref":"#/$defs/AgentLabel"},{"type":"null"}]},"protocol_events":{"format":"uint64","minimum":0,"type":"integer"},"reused":{"type":"boolean"},"stage":{"$ref":"#/$defs/AgentAnalysisStage"},"status":{"$ref":"#/$defs/AgentAnalysisUnitStatus"},"unit_id":{"$ref":"#/$defs/AgentId"}},"required":["unit_id","adapter","status","reused","stage","duration_ms","protocol_events"],"type":"object"},"AgentAnalysisUnitStatus":{"description":"Lifecycle state for one planned analysis unit or source batch.","enum":["queued","running","completed","failed","cancelled","unanalysed"],"type":"string"},"AgentCoverage":{"additionalProperties":false,"properties":{"candidates":{"format":"uint64","minimum":0,"type":"integer"},"completeness":{"items":{"$ref":"#/$defs/AgentToken"},"maxItems":1024,"type":"array"},"dependency_sites":{"format":"uint64","minimum":0,"type":"integer"},"external":{"format":"uint64","minimum":0,"type":"integer"},"files_analyzed":{"format":"uint64","minimum":0,"type":"integer"},"files_discovered":{"format":"uint64","minimum":0,"type":"integer"},"files_skipped":{"format":"uint64","minimum":0,"type":"integer"},"profiles":{"format":"uint64","minimum":0,"type":"integer"},"project_code_executed":{"type":"boolean"},"reasons":{"items":{"$ref":"#/$defs/AgentLabel"},"maxItems":1024,"type":"array"},"resolved":{"format":"uint64","minimum":0,"type":"integer"},"unresolved":{"format":"uint64","minimum":0,"type":"integer"},"unsupported_syntax":{"format":"uint64","minimum":0,"type":"integer"}},"required":["profiles","files_discovered","files_analyzed","files_skipped","dependency_sites","resolved","candidates","external","unresolved","unsupported_syntax","project_code_executed","completeness","reasons"],"type":"object"},"AgentId":{"maxLength":256,"minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:@+-]*$","type":"string"},"AgentLabel":{"maxLength":256,"minLength":1,"pattern":"^[^\\u0000-\\u001f\\u007f]+$","type":"string"},"AgentScanCacheSummary":{"additionalProperties":false,"properties":{"hits":{"format":"uint64","minimum":0,"type":"integer"},"misses":{"format":"uint64","minimum":0,"type":"integer"}},"required":["hits","misses"],"type":"object"},"AgentScanOutcomeContractVersion":{"enum":["depgraph-agent-scan-outcome-v2"],"type":"string"},"AgentScanStatusV2":{"description":"Additive scan outcome contract that can report terminal partial attempts.\nThe original `AgentScanOutcome` remains the v1 completed-only contract.","enum":["completed","partial","failed","cancelled","policy_failed","security_failed"],"type":"string"},"AgentToken":{"maxLength":64,"minLength":1,"pattern":"^[a-z][a-z0-9._:-]*$","type":"string"},"AnalysisInputDigest":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"SnapshotId":{"pattern":"^snapshot:sha256:[0-9a-f]{64}$","type":"string"}},"$id":"https://github.com/TamaT-LLC/depgraph-cli/schemas/depgraph-agent-scan-outcome-v2.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Versioned scan result used by operation/daemon surfaces that need to\nexpose a terminal partial attempt while keeping the v1 tool envelope\nunchanged for existing clients.","properties":{"analysis":{"anyOf":[{"$ref":"#/$defs/AgentAnalysisProgress"},{"type":"null"}]},"analysis_coverage":{"anyOf":[{"$ref":"#/$defs/AgentAnalysisCoverage"},{"type":"null"}]},"cache":{"$ref":"#/$defs/AgentScanCacheSummary"},"completed_snapshot_id":{"anyOf":[{"$ref":"#/$defs/SnapshotId"},{"type":"null"}]},"contract_version":{"$ref":"#/$defs/AgentScanOutcomeContractVersion"},"coverage":{"$ref":"#/$defs/AgentCoverage"},"project_code_executed":{"type":"boolean"},"scan_id":{"$ref":"#/$defs/AgentI