          ],
          "properties": {
            "op": {
              "const": "all"
            },
            "conditions": {
              "type": "array",
              "maxItems": 255,
              "items": {
                "$ref": "#/$defs/condition_0"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
