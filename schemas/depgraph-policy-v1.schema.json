{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TamaT-LLC/depgraph-cli/schemas/depgraph-policy-v1.schema.json",
  "title": "depgraph architecture policy configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rules",
    "suppressions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "suppressions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/suppression"
      }
    }
  },
  "$defs": {
    "contract_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "match_kind": {
      "enum": [
        "exact",
        "prefix",
        "glob"
      ]
    },
    "match_value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "normalized_path_value": {
      "allOf": [
        {
          "$ref": "#/$defs/match_value"
        },
        {
          "pattern": "^[^/\\\\]+(?:/[^/\\\\]+)*$"
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.?($|/)"
          }
        },
        {
          "not": {
            "pattern": "^.:"
          }
        }
      ]
    },
    "match_constraints": {
      "allOf": [
        {
          "if": {
            "properties": {
              "match": {
                "enum": [
                  "exact",
                  "prefix"
                ]
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[^*?\\\\]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "const": "glob"
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[^\\\\\\[\\]\\{\\}]+$"
              }
            }
          }
        }
      ]
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match",
        "value"
      ],
      "properties": {
        "match": {
          "$ref": "#/$defs/match_kind"
        },
        "value": {
          "$ref": "#/$defs/match_value"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/match_constraints"
        }
      ]
    },
    "path_pattern": {
      "allOf": [
        {
          "$ref": "#/$defs/pattern"
        },
        {
          "properties": {
            "value": {
              "$ref": "#/$defs/normalized_path_value"
            }
          }
        }
      ]
    },
    "selector_pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "match",
        "value"
      ],
      "properties": {
        "field": {
          "enum": [
            "id",
            "path",
            "locator",
            "display_name"
          ]
        },
        "match": {
          "$ref": "#/$defs/match_kind"
        },
        "value": {
          "$ref": "#/$defs/match_value"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/match_constraints"
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "id"
              }
            },
            "required": [
              "field"
            ]
          },
          "then": {
            "properties": {
              "match": {
                "const": "exact"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "path"
              }
            },
            "required": [
              "field"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/normalized_path_value"
              }
            }
          }
        }
      ]
    },
    "selector_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path_pattern"
          }
        },
        "packages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pattern"
          }
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "field",
        "match",
        "value",
        "cardinality"
      ],
      "properties": {
        "kind": {
          "enum": [
            "package",
            "file",
            "symbol",
            "type",
            "route"
          ]
        },
        "field": {
          "enum": [
            "id",
            "path",
            "locator",
            "display_name"
          ]
        },
        "match": {
          "$ref": "#/$defs/match_kind"
        },
        "value": {
          "$ref": "#/$defs/match_value"
        },
        "cardinality": {
          "enum": [
            "one",
            "many"
          ]
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/selector_pattern"
          }
        },
        "scope": {
          "$ref": "#/$defs/selector_scope"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/match_constraints"
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "id"
              }
            },
            "required": [
              "field"
            ]
          },
          "then": {
            "properties": {
              "match": {
                "const": "exact"
              },
              "cardinality": {
                "const": "one"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "path"
              }
            },
            "required": [
              "field"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/normalized_path_value"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "not": {
                  "const": "file"
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "field": {
                "not": {
                  "const": "path"
                }
              },
              "exclude": {
                "items": {
                  "properties": {
                    "field": {
                      "not": {
                        "const": "path"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "profile_filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pattern"
          }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pattern"
          }
        }
      }
    },
    "condition_value": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        }
      ]
    },
    "condition_leaf": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "key",
            "value"
          ],
          "properties": {
            "op": {
              "const": "eq"
            },
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            },
            "value": {
              "$ref": "#/$defs/condition_value"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "key",
            "values"
          ],
          "properties": {
            "op": {
              "const": "in"
            },
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/condition_value"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "key"
          ],
          "properties": {
            "op": {
              "const": "defined"
            },
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            }
          }
        }
      ]
    },
    "condition_0": {
      "$ref": "#/$defs/condition_leaf"
    },
    "condition_1": {
