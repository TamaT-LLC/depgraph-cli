      },
      {
        "source": "/docs/products/[id].rsc",
        "sourceRegex": "^/docs/products/([^/]+?)\\.rsc$",
        "destination": "/docs/products/$1.rsc"
      },
      {
        "source": "/docs/_next/data/private-build-id/products/[id].json",
        "sourceRegex": "^/docs/_next/data/private-build-id/products/([^/]+?)\\.json$",
        "destination": "/docs/_next/data/private-build-id/products/$1.json"
      }
    ],
    "onMatch": [],
    "fallback": [],
