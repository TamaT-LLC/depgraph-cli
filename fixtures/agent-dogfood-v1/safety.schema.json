{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TamaT-LLC/depgraph-cli/fixtures/agent-dogfood-v1/safety.schema.json",
  "title": "depgraph Agent dogfood raw safety evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_id", "before", "after", "trace"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agent-dogfood-safety-v1"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^(baseline|mcp)-[1-3]$"
    },
    "before": { "$ref": "#/$defs/snapshot" },
    "after": { "$ref": "#/$defs/snapshot" },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_execution_count",
        "commands_sha256",
        "project_code_execution_observed"
      ],
      "properties": {
        "command_execution_count": { "type": "integer", "minimum": 0 },
        "commands_sha256": { "$ref": "#/$defs/sha256" },
        "project_code_execution_observed": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "store_sha256",
        "journal_sha256",
        "daemon_state_sha256",
        "relevant_processes"
      ],
      "properties": {
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "store_sha256": { "$ref": "#/$defs/sha256" },
        "journal_sha256": { "$ref": "#/$defs/sha256" },
        "daemon_state_sha256": { "$ref": "#/$defs/sha256" },
        "relevant_processes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
